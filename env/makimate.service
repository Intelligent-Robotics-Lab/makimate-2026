[Unit]
Description=MakiMate ROS 2 Stack
After=network.target sound.target
Wants=network.target

[Service]
Type=simple
User=__USER__
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
WorkingDirectory=__REPO_DIR__
ExecStart=/bin/bash __REPO_DIR__/scripts/start_dashboard.sh
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
